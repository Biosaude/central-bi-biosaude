# Somente dados fictícios. Ative explicitamente ao executar npm run dev.
LOCAL_DEMO_ENABLED=false
# Opcional: arquivo SQLite local, nunca um banco dos dashboards existentes.
# LOCAL_SQLITE_PATH=.local/central-bi.sqlite

# Fase 4D: segredos do servidor, carregados apenas pelos módulos PostgreSQL e Entra.
# DATABASE_URL=                # Execução do servidor (central_bi_runtime).
# MIGRATION_DATABASE_URL=      # Somente migração e bootstrap (central_bi_migrator).
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# ENTRA_REDIRECT_URI=
# Selecione o modo corporativo explicitamente.
# PORTAL_AUTH_MODE=entra

# Somente durante o cadastro inicial do administrador.
# BOOTSTRAP_ENTRA_OBJECT_ID=
# BOOTSTRAP_ADMIN_NAME=
# BOOTSTRAP_ADMIN_EMAIL=

# Consulta interna de concessão do Comercial, somente no Preview da Central.
# CENTRAL_BI_ENTITLEMENT_URL=
# CENTRAL_BI_ASSERTION_KEY_ID=
# CENTRAL_BI_ASSERTION_PUBLIC_KEY=
