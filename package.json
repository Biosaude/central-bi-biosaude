{
  "name": "central-bi-biosaude",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:seed": "node --experimental-strip-types scripts/seed.ts",
    "db:migrate:postgres": "node scripts/migrate-postgres.ts",
    "db:bootstrap:admin": "node scripts/bootstrap-admin.ts"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "16.4.4",
    "openid-client": "^6.9.0",
    "pg": "^8.23.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "4.3.4",
    "typescript": "^5.9.0",
    "vitest": "5.1.0"
  }
}
